---
/**
 * Painel de apoio à identificação — fase "apoio" da biblioteca B2.
 *
 * Spinplus: visual do layout aprovado pelo cliente em 15/10/2026 (docs/BRIEFING.md,
 * "Desvios") — seção clara com desenho técnico da sala de compressores à direita, logo
 * Spinplus, título, logo Ingersoll Rand, botão vermelho e faixa branca com os 6 dados.
 * Deixa de ser o bloco navy da fase de apoio. `npm run compose` sobrescreve este arquivo
 * com o da biblioteca: restaure esta versão depois de recompor.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta, header } from '@data/content'
import { site } from '@data/site'
import { supportPanel } from '@data/sections/identificar'
import logo from '@assets/LOGO.png'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="identificar" tone={tone} rhythm={rhythm} class="relative overflow-hidden">
  {/* Desenho técnico à direita, esmaecendo para a esquerda e para baixo (só desktop) */}
  <div
    aria-hidden="true"
    class="support-sketch pointer-events-none absolute top-0 right-0 hidden lg:block"
  >
    <Image
      src={supportPanel.sketch.src}
      alt={supportPanel.sketch.alt}
      format="webp"
      width={1200}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-[40%_top] mix-blend-multiply"
    />
  </div>
  <span aria-hidden="true" class="support-grid pointer-events-none absolute inset-0"></span>

  <div class="relative z-[1] pt-8 lg:pt-14">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
      <div class="min-w-0 lg:flex-1">
        <Image
          src={logo}
          alt={site.brand}
          width={340}
          height={113}
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-11 w-auto sm:h-14"
        />

        <span class="mt-7 inline-flex items-center gap-3 font-sans text-[13px] font-semibold tracking-[0.2em] text-brand-red uppercase sm:text-sm">
          <span class="h-2 w-2 bg-brand-red"></span>
          {supportPanel.eyebrow}
        </span>

        <h2 class="mt-3 font-display text-3xl leading-[1.1] font-extrabold tracking-[-0.01em] text-primary-dark-900 sm:text-4xl lg:text-[2.25rem] xl:text-[2.55rem]">
          {supportPanel.title}
        </h2>

        <p class="mt-4 font-sans text-base leading-relaxed text-ink-soft sm:text-[17px]">
          {supportPanel.text}
          <Image
            src={header.partner.src}
            alt={header.partner.alt}
            width={362}
            height={80}
            format="webp"
            loading="lazy"
            decoding="async"
            class="mt-3 block h-7 w-auto sm:-my-2 sm:ml-5 sm:inline-block sm:align-middle"
          />
        </p>
      </div>

      <div class="flex flex-col items-stretch gap-3 lg:shrink-0 lg:items-end">
        <button
          type="button"
          data-cta="identificar-cta"
          class="btn-slave-whats support-cta inline-flex items-center justify-center gap-3 rounded-md bg-gradient-to-b from-brand-red to-brand-red-dark px-8 py-4 font-sans text-[16px] font-bold text-neutral-light shadow-[0_16px_30px_-14px_rgba(197,26,21,0.75)] sm:text-[17px]"
        >
          {cta.secondary}
          <Icon name="arrow-right" class="size-5 shrink-0" />
        </button>
        <span class="flex items-center justify-center gap-2 font-sans text-[15px] text-ink lg:justify-end">
          <Icon name="shield" class="size-5 shrink-0 text-brand-red" />
          {supportPanel.microcopy}
        </span>
      </div>
    </div>

    <ul class="support-strip mt-10 grid grid-cols-2 rounded-xl border border-neutral-gray-200/50 bg-neutral-light shadow-[0_10px_30px_-22px_rgba(0,24,48,0.45)] sm:grid-cols-3 lg:mt-12 xl:flex">
      {supportPanel.items.map((item) => (
        <li class="support-item flex items-center gap-3.5 px-4 py-5 sm:px-5 xl:flex-1 xl:justify-center lg:gap-2.5 lg:px-3 lg:py-6 xl:gap-3 xl:px-4">
          <Icon name={item.icon} class="size-9 shrink-0 text-brand-red lg:size-8 xl:size-10" />
          <span class="flex min-w-0 flex-col gap-1">
            <span class="font-display text-[15px] leading-tight font-bold text-primary-dark-900 sm:text-base xl:whitespace-nowrap xl:text-[17px]">
              {item.label}
            </span>
            <span class="font-sans text-[12px] leading-snug text-ink-soft sm:text-[13px] xl:whitespace-nowrap">
              {item.hint}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .support-sketch {
    width: min(62vw, 1040px);
    height: 470px;
    opacity: 0.6;
    mask-image:
      linear-gradient(to right, transparent 0%, black 30%),
      linear-gradient(to bottom, black 55%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 30%),
      linear-gradient(to bottom, black 55%, transparent 100%);
    -webkit-mask-composite: source-in;
  }

  /* Malha de prancheta, só no canto superior esquerdo */
  .support-grid {
    background-image:
      linear-gradient(rgb(0 24 48 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(0 24 48 / 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 60% 70% at 15% 20%, black 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 15% 20%, black 0%, transparent 75%);
  }

  /* Divisórias internas, que não encostam no topo nem na base do card */
  .support-item {
    position: relative;
  }

  .support-item::after {
    content: '';
    position: absolute;
    top: 18%;
    right: 0;
    bottom: 18%;
    width: 1px;
    background: rgb(160 160 160 / 0.35);
  }

  .support-item:nth-child(2n)::after {
    display: none;
  }

  @media (width >= 40rem) {
    .support-item:nth-child(2n)::after {
      display: block;
    }

    .support-item:nth-child(3n)::after {
      display: none;
    }
  }

  @media (width >= 80rem) {
    .support-item:nth-child(3n)::after {
      display: block;
    }

    .support-item:last-child::after {
      display: none;
    }
  }

  .support-cta {
    transition:
      transform 200ms ease-out,
      filter 200ms ease-out;
  }

  .support-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .support-cta {
      transition: none;
    }

    .support-cta:hover {
      transform: none;
    }
  }
</style>
