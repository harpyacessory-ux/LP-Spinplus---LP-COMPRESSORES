---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2), na versão Spinplus.
 *
 * Desvio do padrão aprovado pelo cliente em 15/10/2026 (docs/BRIEFING.md, "Desvios"):
 * hero claro em duas colunas — título, texto, destaque e botão à esquerda; foto da sala
 * de compressores emoldurada à direita — fechado por uma faixa vermelha. Sem coluna de
 * chat: o atendimento abre pelo botão (`btn-slave-whats`) e o formulário segue na Cotação.
 * Fundo: foto do galpão claro enviada pelo cliente, sob um véu branco que garante a
 * leitura do texto. As duas imagens disputam o LCP: ambas eager + fetchpriority high,
 * com preload espelhado no Layout.
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import RichText from './RichText.astro'
import { hero } from '../data/content'

/** Primeira linha do H1: o título sem o trecho em destaque. */
const lead = hero.title.replace(hero.highlight, '').trim()
---

<section class="hero-spin relative overflow-hidden" data-hero>
  <div class="relative">
    {/* Fundo: galpão claro com janelas, sob véu branco à esquerda */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <Picture
        src={hero.background.src}
        alt={hero.background.alt}
        widths={[640, 1024, 1536, 1870]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover object-[60%_20%]"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>
    <div aria-hidden="true" class="hero-spin__veil pointer-events-none absolute inset-0"></div>

    <div class="relative mx-auto max-w-page px-6 pt-12 pb-14 lg:px-10 lg:pt-16 lg:pb-20">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
        {/* Coluna 1 — texto e botão */}
        <div class="max-w-xl lg:max-w-none">
          <h1 class="font-display text-[2.35rem] leading-[1.1] text-ink sm:text-[2.9rem] lg:text-[2.6rem] xl:text-[3.15rem]">
            <span class="block font-medium tracking-[-0.015em]">{lead}</span>
            <span class="block font-extrabold tracking-[-0.015em] text-brand-red">
              {hero.highlight}
            </span>
          </h1>

          <p class="mt-6 font-sans text-[17px] leading-relaxed text-ink-soft xl:text-lg">
            <RichText parts={hero.text} />
          </p>

          <p class="mt-6 rounded-xl border border-l-4 border-neutral-gray-200/40 border-l-brand-red bg-neutral-light/90 px-5 py-4 font-sans text-[15px] leading-relaxed text-ink shadow-[0_14px_30px_-20px_rgba(0,24,48,0.45)] sm:text-base">
            <RichText parts={hero.callout} />
          </p>

          <button
            type="button"
            data-cta="hero-primary"
            class="btn-slave-whats hero-spin__cta mt-8 inline-flex w-full items-center justify-center gap-3 rounded-full bg-gradient-to-b from-cta-green to-cta-green-dark px-6 py-4 font-sans text-[15px] font-bold text-neutral-light shadow-[0_16px_30px_-14px_rgba(19,160,42,0.85)] sm:w-auto sm:px-9 sm:text-[17px]"
          >
            <Icon name="chat" class="size-6 shrink-0" />
            <span>{hero.cta}</span>
            <Icon name="chevron-right" class="hero-spin__chevron size-5 shrink-0" />
          </button>
        </div>

        {/* Coluna 2 — foto emoldurada */}
        <div class="relative">
          <div class="overflow-hidden rounded-2xl border-[3px] border-brand-red bg-neutral-light shadow-[0_34px_64px_-34px_rgba(0,24,48,0.6)]">
            <Picture
              src={hero.banner.src}
              alt={hero.banner.alt}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 1320px) 600px, (min-width: 1024px) 46vw, 100vw"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block aspect-[16/9] w-full object-cover object-[40%_50%]"
              pictureAttributes={{ class: 'block' }}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Faixa vermelha que fecha o hero */}
  <div class="hero-spin__band relative bg-brand-red">
    <p class="relative mx-auto max-w-page px-6 py-5 text-center font-sans text-xl leading-snug font-semibold text-neutral-light sm:text-2xl lg:px-10 lg:py-6 lg:text-[28px]">
      <RichText parts={hero.band} strongClass="font-extrabold" />
    </p>
  </div>
</section>

<style>
  /* Cor de segurança enquanto a foto de fundo carrega */
  .hero-spin {
    background-color: #eef1f5;
  }

  /* Véu: no mobile o texto fica sobre a foto inteira, então o branco cobre quase tudo */
  .hero-spin__veil {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.55) 0%, rgb(255 255 255 / 0.82) 100%),
      linear-gradient(to right, rgb(255 255 255 / 0.35) 0%, rgb(255 255 255 / 0.1) 100%);
  }

  /* Desktop: branco forte sob o texto, dissolvendo até a foto aparecer atrás da moldura */
  @media (min-width: 1024px) {
    .hero-spin__veil {
      background:
        linear-gradient(
          to right,
          rgb(255 255 255 / 0.88) 0%,
          rgb(255 255 255 / 0.72) 32%,
          rgb(255 255 255 / 0.2) 58%,
          rgb(255 255 255 / 0) 78%
        ),
        linear-gradient(180deg, rgb(255 255 255 / 0) 60%, rgb(255 255 255 / 0.35) 100%);
    }
  }

  /* Faixa vermelha com cortes diagonais mais claros nas pontas */
  .hero-spin__band {
    background-image:
      linear-gradient(
        115deg,
        transparent 0 6%,
        rgb(255 255 255 / 0.08) 6% 14%,
        transparent 14% 86%,
        rgb(0 0 0 / 0.07) 86% 94%,
        transparent 94%
      ),
      linear-gradient(180deg, var(--color-brand-red) 0%, var(--color-brand-red-dark) 100%);
    box-shadow: inset 0 3px 0 rgb(0 0 0 / 0.06);
  }

  .hero-spin__cta {
    transition:
      transform 200ms ease-out,
      box-shadow 200ms ease-out,
      filter 200ms ease-out;
  }

  .hero-spin__cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow: 0 22px 36px -16px rgb(19 160 42 / 0.9);
  }

  .hero-spin__chevron {
    transition: transform 200ms ease-out;
  }

  .hero-spin__cta:hover .hero-spin__chevron {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-spin__cta,
    .hero-spin__chevron {
      transition: none;
    }

    .hero-spin__cta:hover,
    .hero-spin__cta:hover .hero-spin__chevron {
      transform: none;
    }
  }
</style>
